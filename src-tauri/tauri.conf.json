{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainroots Cards — MVP",
  "version": "0.1.0",
  "identifier": "com.brainroots.cards",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Brainroots Cards — MVP",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/128x128.png"
    ],
    "publisher": "Brainroots",
    "copyright": "© 2025 Brainroots",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
